# Modelo e API
OPENAI_API_KEY=(COLE_AQUI_A_SUA_KEY)
# Use vazio para OpenAI padrao, ou configure para provider OpenAI-compatible.
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gemini-2.5-flash
OPENAI_EMBED_MODEL=text-embedding-004

# RAG
RAG_TOP_K=6
RAG_COLLECTION=gurps_pt_v1
RAG_AUTO_INDEX_ON_STARTUP=1

# Paths para deploy com Root Directory em AGENTE GURPS/backend
CHROMA_DIR=chroma
CHUNKS_FILE=chunks.jsonl
