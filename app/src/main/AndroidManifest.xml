<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 🔴 A camera, para o video do jogador na Mesa (MNA-7/MNA-9).
         A Mesa pede `getUserMedia({video:true})` em `mesa.js`; sem esta linha
         o WebView nao tem o que conceder, e a pagina fica esperando CALADA. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- ⚠️ E o aplicativo NAO exige camera para ser instalado: quem nunca abre
         a Mesa nao precisa dela, e um `required` aqui tiraria o app da loja
         para todo aparelho sem camera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Só para salvar o retrato na galeria no Android 9 ou anterior. Do
         Android 10 em diante o MediaStore grava sem permissão nenhuma. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/icon_app"
        android:label="@string/app_name"
        android:roundIcon="@drawable/icon_app"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.GURPSFicha"
        tools:targetApi="31">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 🔴 MNA-10: uma copia so da tela (`singleTask`).

             A aba da Mesa guarda a sala ACIMA das telas, e ela e uma so. Um
             link `gurpsapp://` abrindo uma segunda copia da MainActivity poria
             duas telas a disputar a mesma janela, e a que perdesse ficaria
             com uma parede vazia. -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GURPSFicha">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Importar ficha: abrir por TIPO MIME (Explorador, Drive, etc.).
                 Inclui octet-stream pois o WhatsApp e muitos apps reatribuem
                 .json/.gurps para esse tipo genérico. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-gurps" />
            </intent-filter>

            <!-- Importar ficha: abrir por EXTENSÃO de arquivo (.gurps/.json).
                 Casa pelo NOME do arquivo mesmo quando o MIME vem genérico/ausente
                 (caso típico do WhatsApp). host="*" + mimeType="*/*" para abranger. -->
            <intent-filter android:label="Importar ficha GURPS">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.gurps" />
                <data android:pathPattern=".*\\..*\\.gurps" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\..*\\.json" />
            </intent-filter>

            <!-- Importar ficha: compartilhar PARA o app (botão Compartilhar do
                 WhatsApp/explorador → "GURPS Ficha"). -->
            <intent-filter android:label="Importar ficha GURPS">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-gurps" />
            </intent-filter>

            <!-- Mesa Virtual: Link Mágico do Discord -->
            <intent-filter android:label="Conectar Mesa Virtual">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gurpsapp" android:host="conectar" />
            </intent-filter>

            <!-- Lote CC-5: a Mesa Virtual pede uma rolagem.
                 gurpsapp://rolar?o=ataque&amp;pericia=espada_larga&amp;mod=-7

                 O MESMO esquema do "conectar", com um host novo. Dois esquemas
                 seriam dois registos para a mesma ligacao entre os dois
                 programas, e no dia em que um mudasse o outro ficaria para tras
                 sem ninguem reparar.

                 O token da sala NAO viaja no link: ver PedidoDaMesa.kt. -->
            <intent-filter android:label="Rolar pela Mesa Virtual">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gurpsapp" android:host="rolar" />
            </intent-filter>
        </activity>
    </application>

</manifest>

